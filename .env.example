OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Choose openai, agentrouter (Token Harbour), gemini, or ollama.
LLM_PROVIDER=openai
OLLAMA_MODEL=qwen3:4b
# Blank: localhost for native Python; host.docker.internal for Docker.
OLLAMA_BASE_URL=
OLLAMA_CONTEXT_LENGTH=16384
# Local investigations include model loading and every tool round trip (max 900).
OLLAMA_DEADLINE_SECONDS=300
OLLAMA_MAX_OUTPUT_TOKENS=1536
GEMINI_API_KEY=
# Free tier available; Google project quotas and billing settings apply.
GEMINI_MODEL=gemini-3.8-flash
AGENTROUTER_API_KEY=
# Token Harbour uses the existing agentrouter provider and environment variables.
AGENTROUTER_BASE_URL=https://tokenharbor.ai/v1
AGENTROUTER_MODEL=deepseek-v4-flash:free
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=knowgraph
FALKORDB_PASSWORD=
API_BASE_URL=http://localhost:8000
AGENT_DEADLINE_SECONDS=60
AGENT_MAX_TOOL_CALLS=8
